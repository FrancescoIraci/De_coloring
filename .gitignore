# Python / tooling
__pycache__/
*.pyc
.ipynb_checkpoints/
.corner_explorer_cache/
.DS_Store
.claude/

# Per-pulsar working files (epoch-wise DM cache, materialized and cut tims,
# refit pars): regenerable with make_feathers_matched.py / make_feather_mjdcut.py.
# Only the two plots the summary uses are tracked.
*/dm_correction_out/*
!*/dm_correction_out/dm_timeseries.png
!*/dm_correction_out/residuals_pre_post.png

# Original EPTA deliveries the pulsar directories were populated from
no_duplicates/
final_dataset_toAurelien/

# Cluster-side noise-analysis outputs (chains and job logs)
samples/
logs/

# Per-run outputs: only the summary.json and the GP reconstruction are kept;
# corner/trace/1D plots are regenerated by plot_posteriors.py and
# plot_gp_timeseries.py. Comparison plots (plot_output/compare/) are tracked.
plot_output/*/*/*/*
!plot_output/*/*/*/summary.json
!plot_output/*/*/*/gp_timeseries.npz

# Scrambling-test histograms (the raw lnL tables next to them are kept)
scramble_dm/out/**/*.png

# LaTeX build artifacts (summary.pdf itself is tracked)
summary/*.aux
summary/*.log
summary/*.out
summary/*.toc
summary/*.synctex.gz
